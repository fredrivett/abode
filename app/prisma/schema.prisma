// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @db.Uuid // matches auth.users.id, no default - set by trigger
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items         Item[]
  visualVectors ItemVisualVector[]
  textVectors   ItemTextVector[]

  @@map("users")
}

enum ItemKind {
  image
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

model Item {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  kind             ItemKind
  processingStatus ProcessingStatus @default(pending) @map("processing_status")
  fileKey          String?          @map("file_key")
  source           String?

  // File metadata e.g. { originalName, size, type, width, height, duration, pageCount, etc. }
  meta             Json?

  // AI-generated metadata (frequently queried, promoted to columns for performance)
  title            String?
  description      String?
  tags             String[]         @default([])  // General labels/keywords
  objects          String[]         @default([])  // Detected objects (car, person, building, etc.)
  ocrText          String?          @map("ocr_text")
  colors           Json?

  // Raw API response (for debugging/reprocessing)
  visionData       Json?            @map("vision_data")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  visualVectors     ItemVisualVector[]
  textVectors       ItemTextVector[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([tags])
  @@index([objects])
  @@map("items")
}

model ItemVisualVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "clip-vit-base-patch32"
  // Note: embedding vector(768) column will be added via Supabase migration (Prisma doesn't support pgvector type)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([userId])
  @@map("item_visual_vectors")
}

model ItemTextVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "text-embedding-3-small"
  // Note: embedding vector(1536) column will be added via Supabase migration (Prisma doesn't support pgvector type)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([userId])
  @@map("item_text_vectors")
}
