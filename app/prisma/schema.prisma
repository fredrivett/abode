// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @db.Uuid // matches auth.users.id, no default - set by trigger
  email                 String    @unique
  username              String?   // Display version (e.g., "Fred_Dev"), case-insensitive unique via index
  previousUsernames     Json?     @map("previous_usernames") // [{username, changedAt}]
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  website               String?   // Personal website / link shown on the public profile
  avatarUrl             String?   @map("avatar_url")
  avatarSource          AvatarSource? @map("avatar_source")
  memberNumber          Int?      @unique @map("member_number") // Sequential member number based on signup order
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  isAdmin               Boolean   @default(false) @map("is_admin")
  storageUsedBytes      BigInt    @default(0) @map("storage_used_bytes")
  itemCount             Int       @default(0) @map("item_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Referral tracking
  referredById      String?        @map("referred_by_id") @db.Uuid
  inviteAllocation  Int            @default(3) @map("invite_allocation") // Total invites this user can have active/accepted
  origin            InviteOrigin?  @map("origin")

  // Relations
  referredBy        User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]  @relation("Referrals")
  sentInvites       Invite[] @relation("SentInvites")

  items             Item[]
  locations         ItemLocation[]
  visualVectors     ItemVisualVector[]
  textVectors       ItemTextVector[]
  rooms             Room[]
  articleHighlights ArticleHighlight[]
  activityLogs      ActivityLog[]
  milestones        UserMilestone[]
  noteDraft         NoteDraft?

  @@map("users")
}

enum ItemKind {
  image
  article
  twitter
  video
  product
  note
  webpage
  book
}

enum SourceType {
  upload
  url
  compose
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

enum RoomType {
  smart
  manual
}

enum RoomVisibility {
  private
  public
}

enum AvatarSource {
  upload
  oauth
  gravatar
}

enum ActivityType {
  item_create
  item_update
  item_delete
  item_view
  room_create
  room_update
  room_delete
  room_view
  user_login
  user_update
  admin_delete_user
  admin_invite_waitlist
  admin_grant_admin
  admin_revoke_admin
}

enum MilestoneType {
  complete_profile
  upload_first_image
  save_first_url
  see_ai_analysis
  search_items
  add_first_tag
  highlight_article
  create_first_room
  create_dynamic_room
  share_room
  invite_friend
}

model Item {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  kind             ItemKind?
  processingStatus ProcessingStatus @default(pending) @map("processing_status")

  // Source tracking
  sourceType       SourceType?      @map("source_type")
  sourceUrl        String?          @map("source_url")

  // Files
  fileKey          String?          @map("file_key")
  coverFileKey     String?          @map("cover_file_key")

  // File metadata e.g. { originalName, size, type, width, height, duration, pageCount, etc. }
  meta             Json?

  // AI-generated metadata (shared across all item types)
  title            String?
  description      String?
  tags             String[]         @default([])  // Auto-generated labels (Vision API)
  userTags         String[]         @default([]) @map("user_tags") // User-added manual tags

  // User-provided notes
  notes            String?

  // Full-text search vector (generated column, managed via raw SQL)
  searchVector     Unsupported("tsvector")?  @map("search_vector")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Smart rooms
  excludeFromPublicRooms Boolean @default(false) @map("exclude_from_public_rooms")

  // External links (e.g. Unsplash, Flickr, Instagram posts of this item)
  // Format: [{ url: string, platform: string }]
  externalLinks    Json?            @default("[]") @map("external_links")

  // Direct sharing: non-null sharedAt ⟺ item is viewable via direct link.
  // sharedHighlights controls whether the owner's highlights appear on the shared view.
  sharedAt         DateTime?        @map("shared_at")
  sharedHighlights Boolean          @default(false) @map("shared_highlights")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  locations         ItemLocation[]
  visualVectors     ItemVisualVector[]
  textVectors       ItemTextVector[]
  articleDetails    ItemArticleDetails?
  imageDetails      ItemImageDetails?
  twitterDetails    ItemTwitterDetails?
  videoDetails      ItemVideoDetails?
  productDetails    ItemProductDetails?
  bookDetails       ItemBookDetails?
  noteDetails       ItemNoteDetails?
  roomItems         RoomItem[]
  highlights        ArticleHighlight[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([tags])
  @@index([userTags])
  @@map("items")
}

model ItemLocation {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid

  // Source of location data (e.g. "exif", "manual", "inferred")
  source      String

  latitude    Float?   @map("latitude")
  longitude   Float?   @map("longitude")

  // Reverse geocoded place (via Mapbox)
  neighborhood String?  @map("neighborhood")
  city         String?  @map("city")
  region       String?  @map("region")
  country      String?  @map("country")
  countryCode  String?  @map("country_code")
  formatted    String?  @map("formatted")

  // Raw payload (gps + place, provider-specific)
  raw         Json?    @map("raw")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([itemId, source])
  @@index([userId, city])
  @@index([userId, country])
  @@index([userId, countryCode])
  @@map("item_locations")
}

model ItemVisualVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "clip-vit-base-patch32"
  embedding Unsupported("vector")? // vector(768)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([itemId, model])
  @@index([itemId])
  @@index([userId])
  @@map("item_visual_vectors")
}

model ItemTextVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "text-embedding-3-small"
  embedding Unsupported("vector")? // vector(1536)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([itemId, model])
  @@index([itemId])
  @@index([userId])
  @@map("item_text_vectors")
}

model ItemArticleDetails {
  itemId      String    @id @map("item_id") @db.Uuid
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  author      String?
  domain      String?
  publishedAt DateTime? @map("published_at")
  readingTime Int?      @map("reading_time") // minutes
  content     String?   // Extracted article text content

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("item_article_details")
}

model ItemImageDetails {
  itemId      String    @id @map("item_id") @db.Uuid
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  objects     String[]  @default([])  // Detected objects (car, person, building, etc.)
  colors      Json?                    // Color palette
  ocrText     String?   @map("ocr_text")
  visionData  Json?     @map("vision_data")  // Raw Vision API response
  captureDate DateTime? @map("capture_date") // EXIF capture timestamp

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([colors], type: Gin)
  @@map("item_image_details")
}

model ItemTwitterDetails {
  itemId          String    @id @map("item_id") @db.Uuid
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  tweetId         String    @map("tweet_id")           // Twitter's ID for the tweet
  authorName      String?   @map("author_name")        // Display name
  authorUsername  String    @map("author_username")    // @handle
  authorAvatarUrl String?   @map("author_avatar_url")
  text            String?                               // Tweet text content
  postedAt        DateTime? @map("posted_at")          // When tweet was posted
  media           Json?     @map("media")              // Array of media objects with type, url, dimensions
  quotedTweetId   String?   @map("quoted_tweet_id")    // If quoting another tweet
  card            Json?     @map("card")               // Link card data (title, description, url, imageUrl)
  coverMediaIndex Int?      @map("cover_media_index")  // Index into media[] for cover image

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("item_twitter_details")
}

model ItemVideoDetails {
  itemId       String    @id @map("item_id") @db.Uuid
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  platform     String                                  // "youtube" | "vimeo"
  videoId      String    @map("video_id")             // Platform-specific video ID
  channelName  String?   @map("channel_name")         // Channel/uploader name
  channelUrl   String?   @map("channel_url")          // Link to channel
  duration     Int?                                    // Duration in seconds (Vimeo only via oEmbed)
  embedUrl     String?   @map("embed_url")            // Privacy-respecting embed URL
  thumbnailUrl String?   @map("thumbnail_url")        // Original thumbnail URL from oEmbed

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("item_video_details")
}

model ItemProductDetails {
  itemId          String    @id @map("item_id") @db.Uuid
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  domain          String?
  brand           String?
  price           String?
  currency        String?
  availability    String?
  images          Json?
  coverImageIndex Int?      @map("cover_image_index")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("item_product_details")
}

model ItemBookDetails {
  itemId      String    @id @map("item_id") @db.Uuid
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  authors     String[]  @default([])
  publisher   String?
  publishedAt DateTime? @map("published_at")
  isbn        String?
  pageCount   Int?      @map("page_count")
  domain      String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("item_book_details")
}

model ItemNoteDetails {
  itemId    String   @id @map("item_id") @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // User-authored markdown body (canonical content for note items)
  content   String   @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("item_note_details")
}

/// Singleton in-progress draft for the inline note composer, one per user.
/// This is ephemeral compose text, not an Item — it never appears in the grid,
/// search, rooms, or public profile. Cleared when the note is saved.
model NoteDraft {
  userId    String   @id @map("user_id") @db.Uuid
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("note_drafts")
}

model Room {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  name       String
  slug       String?
  emoji      String?        // Optional emoji icon for the room
  type       RoomType
  filters    Json?          // JSONB for smart room filters
  visibility RoomVisibility @default(private)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomItems      RoomItem[]
  embedReferrers RoomEmbedReferrer[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("rooms")
}

model RoomItem {
  id      String   @id @default(uuid()) @db.Uuid
  roomId  String   @map("room_id") @db.Uuid
  itemId  String   @map("item_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([roomId, itemId])
  @@index([roomId])
  @@index([itemId])
  @@map("room_items")
}

model RoomEmbedReferrer {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  referrerUrl    String   @map("referrer_url")
  referrerDomain String?  @map("referrer_domain")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  viewCount      Int      @default(1) @map("view_count")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, referrerUrl])
  @@index([roomId, lastSeenAt(sort: Desc)])
  @@map("room_embed_referrers")
}

model ArticleHighlight {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid

  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  text        String   // Denormalized for display/search
  note        String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([userId])
  @@map("article_highlights")
}

model ActivityLog {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model UserMilestone {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        MilestoneType
  completedAt DateTime      @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_milestones")
}

// ============================================================================
// Invite & Waitlist System
// ============================================================================

// Origin of invite/user - how they got access
enum InviteOrigin {
  user      // Invited by another user
  waitlist  // Promoted from waitlist by admin
  admin     // Manually added by admin
}

enum InviteStatus {
  pending
  accepted
  joined_elsewhere
}

// Single table for ALL invite tokens - user invites, waitlist promotions, admin invites
model Invite {
  id              String       @id @default(uuid()) @db.Uuid
  email           String
  token           String       @unique
  origin          InviteOrigin @map("origin")
  status          InviteStatus @default(pending)
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  acceptedAt      DateTime?    @map("accepted_at")
  sendCount       Int          @default(1) @map("send_count") // How many times this invite was (re)sent
  acceptedByUserId String?     @map("accepted_by_user_id") @db.Uuid

  // For user invites (origin: user)
  inviterId       String?      @map("inviter_id") @db.Uuid
  inviter         User?        @relation("SentInvites", fields: [inviterId], references: [id], onDelete: SetNull)

  // For waitlist invites (origin: waitlist)
  waitlistEntryId String?      @map("waitlist_entry_id") @db.Uuid
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)

  @@unique([inviterId, email]) // User can't invite same email twice
  @@index([token])
  @@index([email])
  @@index([inviterId])
  @@index([acceptedByUserId])
  @@map("invites")
}

// Waitlist entries - users waiting to be invited
model WaitlistEntry {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  position       Int?      // Queue position, nullable if not tracking
  referralSource String?   @map("referral_source") // "twitter", "producthunt", etc.
  createdAt      DateTime  @default(now()) @map("created_at")

  // Invites created for this waitlist entry (usually 1, more if resent)
  invites        Invite[]

  @@index([createdAt])
  @@map("waitlist_entries")
}
