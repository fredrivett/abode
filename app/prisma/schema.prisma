// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @db.Uuid // matches auth.users.id, no default - set by trigger
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items         Item[]
  locations     ItemLocation[]
  visualVectors ItemVisualVector[]
  textVectors   ItemTextVector[]

  @@map("users")
}

enum ItemKind {
  image
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

model Item {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  kind             ItemKind
  processingStatus ProcessingStatus @default(pending) @map("processing_status")
  fileKey          String?          @map("file_key")
  source           String?

  // File metadata e.g. { originalName, size, type, width, height, duration, pageCount, etc. }
  meta             Json?

  // AI-generated metadata (frequently queried, promoted to columns for performance)
  title            String?
  description      String?
  tags             String[]         @default([])  // General labels/keywords
  objects          String[]         @default([])  // Detected objects (car, person, building, etc.)
  ocrText          String?          @map("ocr_text")
  colors           Json?

  // Raw API response (for debugging/reprocessing)
  visionData       Json?            @map("vision_data")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  locations         ItemLocation[]
  visualVectors     ItemVisualVector[]
  textVectors       ItemTextVector[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@index([tags])
  @@index([objects])
  @@map("items")
}

model ItemLocation {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid

  // Source of location data (e.g. "exif", "manual", "inferred")
  source      String

  latitude    Float?   @map("latitude")
  longitude   Float?   @map("longitude")

  // Reverse geocoded place (via Mapbox)
  neighborhood String?  @map("neighborhood")
  city         String?  @map("city")
  region       String?  @map("region")
  country      String?  @map("country")
  countryCode  String?  @map("country_code")
  formatted    String?  @map("formatted")

  // Raw payload (gps + place, provider-specific)
  raw         Json?    @map("raw")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([itemId, source])
  @@index([userId, city])
  @@index([userId, country])
  @@index([userId, countryCode])
  @@map("item_locations")
}

model ItemVisualVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "clip-vit-base-patch32"
  embedding Unsupported("vector")? // vector(768)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([userId])
  @@map("item_visual_vectors")
}

model ItemTextVector {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   // e.g., "text-embedding-3-small"
  embedding Unsupported("vector")? // vector(1536)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([userId])
  @@map("item_text_vectors")
}
