{
  "name": "project-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3300",
    "build": "next build --turbopack",
    "start": "next start -p 3300",
    "lint": "biome check",
    "lint:all": "bunx concurrently --success=all -n biome,TS -c cyan,magenta \"bun run format\" \"bun run ts:check\"",
    "fix": "biome check --fix",
    "fix:unsafe": "biome check --fix --unsafe",
    "format": "biome format --write",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "ts": "tsc --watch",
    "ts:check": "tsc --noEmit",
    "storybook": "storybook dev -p 6306 --quiet",
    "storybook:build": "storybook build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "supabase:start": "bash -lc '(cd .. && supabase start)'",
    "supabase:stop": "bash -lc '(cd .. && supabase stop)'",
    "supabase:status": "bash -lc '(cd .. && supabase status)'",
    "supabase:studio": "bash -lc 'open http://localhost:56323'"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "@masonry-grid/react": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.2",
    "@tanstack/react-query": "^5.90.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.553.0",
    "next": "16.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@chromatic-com/storybook": "^4.1.2",
    "@storybook/addon-a11y": "^10.0.7",
    "@storybook/addon-docs": "^10.0.7",
    "@storybook/addon-vitest": "^10.0.7",
    "@storybook/nextjs-vite": "^10.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "concurrently": "^9.2.1",
    "dotenv": "^16.5.0",
    "playwright": "^1.56.1",
    "prisma": "^6.19.0",
    "storybook": "^10.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
