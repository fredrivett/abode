    "@radix-ui/react-tooltip": "^1.2.8",
    "@serwist/next": "^9.5.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.86.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@trigger.dev/sdk": "4.3.3",
