{
  "name": "abode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx react-grab-claude-code && bunx next dev --turbopack -p ${CONDUCTOR_PORT:-3300}",
    "build": "next build --webpack",
    "start": "next start -p ${CONDUCTOR_PORT:-3300}",
    "lint": "bunx -p @biomejs/biome biome check",
    "lint:all": "bunx concurrently --success=all -n biome,TS -c cyan,magenta \"bun run format\" \"bun run ts:check\"",
    "fix": "bunx -p @biomejs/biome biome check --fix",
    "fix:unsafe": "bunx -p @biomejs/biome biome check --fix --unsafe",
    "check:fix": "bun run fix && bun run ts:check",
    "format": "bunx -p @biomejs/biome biome format --write",
    "test": "vitest --project unit",
    "test:watch": "vitest watch --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --project integration --run",
    "test:all": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ts": "tsc --watch",
    "ts:check": "tsc --noEmit",
    "storybook": "storybook dev -p 6306 --quiet",
    "storybook:build": "storybook build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "supabase:start": "bash -lc '(cd .. && supabase start)'",
    "supabase:stop": "bash -lc '(cd .. && supabase stop)'",
    "supabase:status": "bash -lc '(cd .. && supabase status)'",
    "supabase:studio": "bash -lc 'open http://localhost:56323'"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "@masonry-grid/react": "^1.1.1",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.86.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@trigger.dev/sdk": "4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "defuddle": "^0.6.6",
    "exifr": "^7.1.3",
    "input-otp": "^1.4.2",
    "lru-cache": "^11.2.4",
    "lucide-react": "^0.553.0",
    "markdown-to-jsx": "^9.3.5",
    "motion": "^12.23.26",
    "next": "16.0.7",
    "openai": "^6.10.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "react": "19.2.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "19.2.1",
    "react-image-crop": "^11.0.10",
    "replicate": "^1.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@chromatic-com/storybook": "^4.1.1",
    "@playwright/test": "^1.56.1",
    "@react-grab/claude-code": "^0.0.88",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/addon-themes": "^10.0.8",
    "@storybook/addon-vitest": "^9.1.10",
    "@storybook/nextjs": "^9.1.10",
    "@storybook/nextjs-vite": "^9.1.10",
    "@testcontainers/postgresql": "^11.10.0",
    "@trigger.dev/build": "4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "concurrently": "^9.2.1",
    "dotenv": "^16.5.0",
    "jsdom": "26",
    "storybook": "^9.1.10",
    "typescript": "5.9.3",
    "vitest": "^4.0.8"
  }
}
