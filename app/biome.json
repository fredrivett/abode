{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": [
    "./biome/no-hardcoded-ellipsis.grit",
    "./biome/no-stub.grit",
    "./biome/no-mouse-down-tap.grit",
    "./biome/no-small-input-text.grit"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!app/.next",
      "!dist",
      "!build",
      "!**/*.css",
      "!**/*.html",
      "!**/*.svg",
      "!public/embed.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["**", "!biome/**/*.grit"]
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "error",
        "noExplicitAny": "error",
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useSortedClasses": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["prisma/seed.ts", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "trigger/**",
        "src/app/api/**",
        "!trigger/check-gravatar.ts",
        "!src/app/api/v1/map-image/route.ts",
        "!src/app/api/v1/twitter-video/route.ts"
      ],
      "plugins": ["./biome/no-raw-fetch.grit"]
    },
    {
      "includes": ["src/lib/items/**", "src/app/api/**"],
      "plugins": ["./biome/no-raw-user-processing.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/lib/supabase/server.ts",
        "!src/lib/supabase/middleware.ts",
        "!src/lib/auth/authenticate-request.ts",
        "!src/lib/admin/auth.ts",
        "!src/lib/actions/auth.ts",
        "!src/app/(auth)/**",
        "!src/app/(app)/admin/verify/page.tsx",
        "!src/hooks/use-upload.ts",
        "!src/hooks/use-save-scanned-document.ts",
        "!src/app/(app)/dashboard/upload-widget.tsx"
      ],
      "plugins": ["./biome/no-raw-cookie-getuser.grit"]
    },
    {
      "includes": ["src/**", "!src/components/seo/json-ld.tsx"],
      "plugins": ["./biome/no-raw-json-ld.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/lib/db.ts",
        "!src/lib/auth/authenticate-request.ts",
        "!src/lib/usage-limits.ts",
        "!src/lib/invites/index.ts",
        "!src/lib/invites/share-invite.ts",
        "!src/lib/waitlist/index.ts",
        "!src/lib/embed-tracking/index.ts",
        "!src/lib/items/image-key-lookup.ts",
        "!src/lib/username/generate-from-email.ts",
        "!src/lib/admin/**",
        "!src/lib/activity/index.ts",
        "!src/lib/jobs/start-failures.ts",
        "!src/app/(app)/admin/**",
        "!src/app/api/v1/admin/**",
        "!src/app/api/v1/embed/**",
        "!src/app/api/v1/username/check/route.ts",
        "!src/app/api/v1/twitter-video/route.ts",
        "!src/app/api/v1/items/\\[id\\]/pages/route.ts",
        "!src/app/api/v1/items/\\[id\\]/retry/route.ts",
        "!src/app/api/v1/rooms/\\[id\\]/items/route.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/__tests__/**"
      ],
      "plugins": ["./biome/no-unlisted-system-db.grit"]
    },
    {
      "includes": ["src/**/*.tsx"],
      "plugins": ["./biome/no-render-platform-detection.grit"]
    },
    {
      "includes": ["src/**", "trigger/**", "!src/lib/storage-objects.ts"],
      "plugins": ["./biome/no-raw-storage-list.grit"]
    },
    {
      "includes": [
        "src/**/*.tsx",
        "!src/lib/og/**",
        "!**/opengraph-image.tsx",
        "!src/components/scanner/**",
        "!src/components/avatar/avatar-cropper.tsx",
        "!src/app/(app)/settings/_components/security-settings.tsx",
        "!src/app/(marketing)/**",
        "!src/**/*.stories.tsx"
      ],
      "plugins": ["./biome/no-raw-img.grit"]
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
