{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": [
    "./biome/no-hardcoded-ellipsis.grit",
    "./biome/no-stub.grit",
    "./biome/no-mouse-down-tap.grit"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!app/.next",
      "!dist",
      "!build",
      "!**/*.css",
      "!**/*.html",
      "!**/*.svg",
      "!public/embed.js",
      "!src/lib/analytics/ui-labels.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["**", "!biome/**/*.grit"]
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "error",
        "noExplicitAny": "error",
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useSortedClasses": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["prisma/seed.ts", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "trigger/**",
        "src/app/api/**",
        "!trigger/check-gravatar.ts",
        "!src/app/api/v1/map-image/route.ts",
        "!src/app/api/v1/twitter-video/route.ts"
      ],
      "plugins": ["./biome/no-raw-fetch.grit"]
    },
    {
      "includes": ["src/lib/items/**", "src/app/api/**"],
      "plugins": ["./biome/no-raw-user-processing.grit"]
    },
    {
      "includes": ["src/app/api/**"],
      "plugins": ["./biome/no-raw-cookie-getuser.grit"]
    },
    {
      "includes": ["src/**", "!src/components/seo/json-ld.tsx"],
      "plugins": ["./biome/no-raw-json-ld.grit"]
    },
    {
      "includes": ["src/**/*.tsx"],
      "plugins": ["./biome/no-render-platform-detection.grit"]
    },
    {
      "includes": ["src/**", "trigger/**", "!src/lib/storage-objects.ts"],
      "plugins": ["./biome/no-raw-storage-list.grit"]
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
