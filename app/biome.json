{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "plugins": ["./biome/no-hardcoded-ellipsis.grit"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!app/.next",
      "!dist",
      "!build",
      "!**/*.css",
      "!public/embed.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["!biome/**/*.grit"]
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "warn",
        "noUnnecessaryConditions": "warn",
        "useReactFunctionComponents": "warn"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
