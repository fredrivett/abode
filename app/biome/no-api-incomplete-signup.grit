language js

// Invite-only guardrail: API routes must resolve the cookie user through
// `getCompletedSignupUser` (@/lib/auth/completed-signup-user), or through
// `authenticateRequest` for extension/token routes, never `getUserWithMfa`
// directly. Completing signup means claiming an invite, so an email-confirmed
// account that never claimed one has a user but no username. The pages turn it
// away (`requireCompletedSignup`), but route handlers aren't wrapped by the
// `(app)` layout: a route that only calls getUserWithMfa would serve it.
//
// Scoped by an `overrides` entry in biome.json to `src/app/api/**`. Biome 2.2
// can't suppress plugin diagnostics with `biome-ignore`, so a route that must
// serve incomplete accounts has to be exempted by path in that override.
// Matches every reference to the name, not just a bare call: an import
// (aliased or not) and a namespace member such as `server.getUserWithMfa`.
or {
  `getUserWithMfa`,
  `getUserWithMfa as $alias`,
  `$obj.getUserWithMfa`
} as $ref where {
  register_diagnostic(
    span=$ref,
    message="API routes must resolve the user with `getCompletedSignupUser(supabase)` from `@/lib/auth/completed-signup-user` (or `authenticateRequest`), not `getUserWithMfa` — it also rejects an account that hasn't completed signup (claimed an invite).",
    severity="error"
  )
}
