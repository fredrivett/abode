language js

// 2FA guardrail: server code must resolve the cookie user through
// `getUserWithMfa` (@/lib/supabase/server) — or helpers built on it
// (getAuthUser, getOAuthMetadata, getAuthenticatedUser) — never
// `supabase.auth.getUser()` directly. getUserWithMfa nulls the user when a
// verified MFA factor exists but the session is still AAL1 (password sign-in,
// TOTP challenge not completed). A raw getUser accepts that AAL1 session and
// silently bypasses the 2FA the user opted into: API routes and server actions
// can be called directly, and pages outside the middleware's protected list
// (e.g. public room/item pages deciding "is this the owner?") never see the
// challenge.
//
// Scoped by an `overrides` entry in biome.json to all of `src/**`, minus the
// callers that legitimately run at AAL1 or apply the AAL check themselves:
// getUserWithMfa/getAuthUser (src/lib/supabase/server.ts), updateSession
// (src/lib/supabase/middleware.ts), authenticateRequest and checkAdminAccess
// (same AAL check), signOut (must work mid-challenge), the (auth) pages
// (login, MFA challenge, signup completion, password reset) and the admin MFA
// challenge page, plus browser-side upload hooks that only read the user id
// for a storage path (storage policies enforce aal2 themselves).
//
// Biome 2.2 can't suppress plugin diagnostics with `biome-ignore`, so a genuine
// exception must be exempted by path in that biome.json override.
//
// Matches `.auth.getUser(...)` on any receiver; the `.auth.` segment keeps it
// from flagging unrelated `getUser` methods.
`$obj.auth.getUser($...)` as $call where {
  register_diagnostic(
    span=$call,
    message="Don't call supabase.auth.getUser() directly — it accepts an AAL1 cookie session and bypasses 2FA. Use `getUserWithMfa(supabase)` from `@/lib/supabase/server` (drop-in for getUser that gates MFA), or `authenticateRequest` for bearer/PAT routes.",
    severity="error"
  )
}
