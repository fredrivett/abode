# Copy to `.env` (dev) or `.env.production` and fill in.
# These are PUBLIC values — the same anon key/URL the web app ships in its
# NEXT_PUBLIC_* vars. Never put the Supabase service-role key here.

# The abode web app the extension saves to. Leave unset for local dev — the
# build auto-targets your dev server (Conductor's CONDUCTOR_PORT, else :3300).
# Set it only to override, e.g. a store build in .env.production:
# WXT_ABODE_BASE_URL=https://www.abode.fyi

# Supabase project (auth). Local dev defaults shown; use your project's values
# for a real build.
WXT_SUPABASE_URL=http://localhost:55321
WXT_SUPABASE_ANON_KEY=
