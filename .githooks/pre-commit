#!/usr/bin/env bash
#
# Pre-commit checks: blocks a commit if gitleaks finds a secret in the staged
# changes, or if a staged file in app/ fails Biome (lint/format). Activate once
# per clone with:
#
#   git config core.hooksPath .githooks
#
# gitleaks is a standalone Go binary (no npm package) — install via your OS
# package manager or a release binary: https://github.com/gitleaks/gitleaks#installing
# (e.g. `brew install gitleaks`, or download from the GitHub releases page).
# CI runs the same scan (.github/workflows/security.yml), so this is a fast
# local backstop, not the only line of defence.

set -euo pipefail

# Biome first: a file written after the last `bun run check:fix` otherwise only
# fails in CI. Read-only, and checks the staged (index) content — not
# `biome check --staged`, which reads the working tree for staged paths.
if [ -x app/node_modules/.bin/biome ]; then
  biome_failed=0
  full=()
  partial=()
  # NUL-delimited so paths with special characters aren't quoted
  while IFS= read -r -d '' path; do
    if git diff --quiet -- "$path"; then
      full+=("${path#app/}")
    else
      partial+=("$path") # partly staged (git add -p): working tree differs from the commit
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACMR -- app)

  if [ ${#full[@]} -gt 0 ] && ! (cd app && ./node_modules/.bin/biome check \
    --no-errors-on-unmatched --files-ignore-unknown=true --colors=off -- "${full[@]}"); then
    biome_failed=1
  fi

  # Biome can't lint a blob read-only, so compare each partly staged blob with
  # Biome's fixed output. This catches format + fixable lint only; unfixable
  # lint in a partly staged file is left to CI
  if [ ${#partial[@]} -gt 0 ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    for path in "${partial[@]}"; do
      case "$path" in *.js | *.jsx | *.mjs | *.cjs | *.ts | *.tsx | *.mts | *.cts | *.json | *.jsonc) ;; *) continue ;; esac
      git show ":$path" >"$tmp/staged"
      if ! (cd app && ./node_modules/.bin/biome check --write --stdin-file-path="${path#app/}" \
        <"$tmp/staged" >"$tmp/fixed"); then
        echo "✖ $path: Biome errored checking the staged version (see above)."
        biome_failed=1
      elif ! cmp -s "$tmp/staged" "$tmp/fixed"; then
        echo "✖ $path: the staged version needs Biome fixes (lint/format)."
        biome_failed=1
      fi
    done
  fi

  if [ "$biome_failed" -ne 0 ]; then
    echo
    echo "❌ Biome found lint/format issues in staged files (see above)."
    echo "   Run 'bun run fix' in app/, re-stage, then commit."
    exit 1
  fi
else
  echo "⚠️  app dependencies not installed — skipping local Biome check (CI still runs it)."
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠️  gitleaks not installed — skipping local secret scan."
  echo "   Install it so commits are checked before push:"
  echo "   https://github.com/gitleaks/gitleaks#installing"
  echo "   CI will still scan on push/PR."
  exit 0
fi

# --staged scans only what is about to be committed; --redact keeps secrets out of output.
if ! gitleaks protect --staged --redact --verbose; then
  echo
  echo "❌ gitleaks found a potential secret in your staged changes (see above)."
  echo "   Remove/rotate it before committing. If it is a false positive, add an"
  echo "   allow rule to a .gitleaks.toml or use 'git commit --no-verify' knowingly."
  exit 1
fi
