{
  "mcpServers": {
    "trigger": {
      "command": "npx",
      "args": ["trigger.dev@4.3.0", "mcp"],
      "env": {
        "TRIGGER_ACCESS_TOKEN": "${TRIGGER_ACCESS_TOKEN}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=${SUPABASE_PROJECT_REF}",
        "--features=database,debug,development,functions,branching,account,storage"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
