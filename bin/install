#!/bin/bash

set -euo pipefail

# Export everything in .env if present
if [[ -f ./.env ]]; then
  set -a; source ./.env; set +a
fi

# Export overrides from .env.local if present
if [[ -f ./.env.local ]]; then
  set -a; source ./.env.local; set +a
fi

# Keep app/.env pointing to the root .env.local so Next.js picks it up.
ensure_app_env_link() {
  if [[ -f ./.env.local ]]; then
    if [[ ! -L ./app/.env || "$(readlink ./app/.env)" != "../.env.local" ]]; then
      echo "Linking app/.env -> ../.env.local"
      ln -sf ../.env.local ./app/.env
    fi
  fi
}

ensure_app_env_link

# Start Supabase for development
if [[ "${SCRIPT_ENV:-development}" = "development" ]]; then
  if command -v bunx >/dev/null 2>&1 && command -v docker >/dev/null 2>&1; then
    if [[ -d "./.supabase" || -f "./supabase/config.toml" ]]; then
      echo "Starting Supabase..."
      bunx supabase start || echo "Supabase start failed or not configured; continuing..."
    fi
  fi
fi

# Install dependencies inside app/
cd app
echo "Installing dependencies..."
bun install

echo "Setting up database..."
bun run prisma:generate

echo "Applying migrations..."
if bun run prisma:deploy; then
  echo "Installation complete!"
  echo "Run 'bin/dev' to start the development server."
else
  echo "Database setup failed. Make sure:"
  echo "  1. Supabase is running (check Docker containers)"
  echo "  2. Environment variables are set (.env file with DATABASE_URL and DIRECT_URL)"
  echo "  3. No port conflicts (default: 56322)"
  exit 1
fi
