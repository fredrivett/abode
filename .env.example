# Self-hosting: this instance's public URL (e.g. https://abode.example.com), used
# for links in emails, share links and SEO. Leave blank locally and on the hosted
# abode.fyi. Set it in your Trigger.dev env too (admin emails link back here).
NEXT_PUBLIC_SITE_URL=

# Supabase (local dev ports)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:55322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:55322/postgres
READ_REPLICA_DATABASE_URL= # optional
PRISMA_LOG_QUERIES=false
# SUPABASE_PROJECT_REF: your remote project ref (the subdomain of your project URL,
# e.g. abcdefgh in https://abcdefgh.supabase.co). Only needed for the Supabase MCP
# server (.mcp.json) and CI branch tooling — not required to boot the app locally.
SUPABASE_PROJECT_REF=

# Google Cloud Vision API (optional): dominant colours for images, and full-page
# OCR for scanned documents and the scanned pages of uploaded PDFs (pages with an
# embedded text layer aren't OCR'd). Without it colours are skipped and document
# OCR falls back to OpenAI when OPENAI_API_KEY is set (with neither, scanned
# pages are saved without text).
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Create a service account, download JSON key, and paste the entire JSON object here
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CREDENTIALS=

# Replicate API (for CLIP image embeddings)
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# OpenAI API (for text embeddings)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Jev / TypeSafe (optional — calibrated article-vs-webpage item-kind refinement)
# When unset, classification falls back to the structural heuristic.
# Get your API key from: https://typesafe.ai (or route via OpenRouter)
JEV_API_KEY=
# Optional: override the API base URL (e.g. to route via OpenRouter). Leave blank
# to use the default (https://api.typesafe.ai/v1).
JEV_BASE_URL=

# Mapbox (reverse geocoding + static map images)
# Get your access token from: https://account.mapbox.com/access-tokens/
# Required scopes: styles:tiles (for static images)
# Free tier: 100,000 requests/month for geocoding, 50,000 for static images
MAPBOX_ACCESS_TOKEN=

# Trigger.dev (for async background jobs)
# Get your secret key from: https://cloud.trigger.dev (Project Settings > API Keys)
# Dev key for local development, prod key for deployment
TRIGGER_SECRET_KEY=
# Optional: base URL of this env's Trigger runs dashboard (Project > Runs — copy
# the URL, drop any query string). Powers the "Monitor" link in the admin
# reprocess UI; leave blank to hide it. e.g.
# https://cloud.trigger.dev/orgs/<org>/projects/<project>/env/<env>/runs
TRIGGER_RUNS_DASHBOARD_URL=

# Data export (optional): largest ZIP part in MiB, default 45. Each part is one
# Supabase Storage upload, so it must fit the project's global upload limit
# (Dashboard > Storage > Settings; 50 MB by default and while a spend cap is on).
# Raise the limit, then this, for fewer and bigger parts. Exports are built by
# Trigger.dev, so set it in the Trigger.dev task environment too.
DATA_EXPORT_PART_MB=

# Resend (for transactional emails - invites, waitlist notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="fred @ abode <fred@abode.fyi>"

# Preview seed user (only needed to run prisma/seed.ts — preview deploys + local seeding)
# Password for the demo "seed@preview.abode.fyi" account. Also set this in the Vercel Preview env.
SEED_USER_PASSWORD=
